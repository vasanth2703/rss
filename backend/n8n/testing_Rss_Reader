      "parameters": {
        "jsCode": "// LogiPulse / Live News Testing Content Deduplicator & Classifier\n// Sections: All | Shipping | Logistics (with Freight Forwarding & Import/Export highlighted in title)\n// 1. Filters out articles older than 7 days\n// 2. Skips exact URL duplicates (comparing with Cloudflare D1 and current batch)\n// 3. Skips similar/scraped/rephrased duplicate stories (comparing with Cloudflare D1 and current batch)\n// 4. Classifies into Shipping or Logistics\n// 5. Sets content_type to 'news' or 'trend'\n\nconst MAX_DAYS = 7;\nconst cutoffTime = Date.now() - (MAX_DAYS * 24 * 60 * 60 * 1000);\n\n// Stop words for title tokenization and similarity comparison\nconst stopWords = new Set([\n  'a', 'about', 'above', 'after', 'again', 'against', 'all', 'am', 'an', 'and',\n  'any', 'are', 'as', 'at', 'be', 'because', 'been', 'before', 'being', 'below',\n  'between', 'both', 'but', 'by', 'can', 'could', 'did', 'do', 'does', 'doing',\n  'down', 'during', 'each', 'few', 'for', 'from', 'further', 'had', 'has', 'have',\n  'having', 'he', 'her', 'here', 'how', 'i', 'if', 'in', 'into', 'is', 'it',\n  'its', 'just', 'more', 'most', 'must', 'my', 'no', 'nor', 'not', 'now', 'of',\n  'off', 'on', 'once', 'only', 'or', 'other', 'our', 'out', 'over', 'own', 'same',\n  'she', 'should', 'so', 'some', 'such', 'than', 'that', 'the', 'their', 'theirs',\n  'them', 'then', 'there', 'these', 'they', 'this', 'those', 'through', 'to',\n  'too', 'under', 'until', 'up', 'very', 'was', 'we', 'were', 'what', 'when',\n  'where', 'which', 'while', 'who', 'whom', 'why', 'will', 'with', 'you', 'your',\n  'says', 'said', 'new', 'top', 'first', 'week', 'report', 'reports', 'amid',\n  'due', 'via', 'latest', 'today', 'daily', 'update', 'news'\n]);\n\nfunction cleanTitleText(t) {\n  let text = (t || '').trim();\n  if (text.includes(' - ')) {\n    const parts = text.split(' - ');\n    parts.pop();\n    text = parts.join(' - ').trim();\n  }\n  if (text.includes(' | ')) {\n    const parts = text.split(' | ');\n    parts.pop();\n    text = parts.join(' | ').trim();\n  }\n  return text;\n}\n\nfunction normalize(t) {\n  return cleanTitleText(t)\n    .toLowerCase()\n    .replace(/[^a-z0-9]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction extractWords(text) {\n  return new Set(\n    cleanTitleText(text)\n      .toLowerCase()\n      .replace(/[^a-z0-9\\s]/g, ' ')\n      .split(/\\s+/)\n      .filter(w => w.length >= 3 && !stopWords.has(w))\n  );\n}\n\nfunction isSimilar(titleA, titleB) {\n  const normA = normalize(titleA);\n  const normB = normalize(titleB);\n  if (!normA || !normB) return false;\n  if (normA === normB) return true;\n  if (normA.length > 15 && normB.length > 15) {\n    if (normA.startsWith(normB) || normB.startsWith(normA)) return true;\n    if (normA.includes(normB) || normB.includes(normA)) return true;\n  }\n\n  const a = extractWords(titleA);\n  const b = extractWords(titleB);\n  if (a.size === 0 || b.size === 0) return false;\n\n  let common = 0;\n  for (const w of a) {\n    if (b.has(w)) common++;\n  }\n\n  const minSize = Math.min(a.size, b.size);\n  if (common >= 3 && (common / minSize) >= 0.5) return true;\n  if (common >= 4) return true;\n\n  return (common / minSize) >= 0.6;\n}\n\n// 1. Read existing headlines and URLs already stored in Cloudflare D1\nconst existingTitles = [];\nconst existingUrls = new Set();\ntry {\n  const d1Res = $('Get Existing D1 Headlines').first()?.json;\n  if (d1Res && Array.isArray(d1Res.data)) {\n    for (const item of d1Res.data) {\n      if (item.title) existingTitles.push(item.title);\n      if (item.source_url) existingUrls.add(item.source_url.trim());\n    }\n  }\n} catch (e) {}\n\nconst incomingItems = $input.all();\nconst acceptedArticles = [];\nconst acceptedTitles = [];\nconst seenUrls = new Set();\n\nfor (const item of incomingItems) {\n  const raw = item.json;\n\n  // Date check: only within last 7 days\n  const rawDate = raw.pubDate || raw.isoDate || raw.published;\n  const pubTime = rawDate ? new Date(rawDate).getTime() : Date.now();\n  if (isNaN(pubTime) || pubTime < cutoffTime) continue;\n\n  // URL check\n  const sourceUrl = (raw.link || raw.guid || '').trim();\n  if (!sourceUrl || seenUrls.has(sourceUrl) || existingUrls.has(sourceUrl)) continue;\n\n  // Clean Title and extract source\n  let title = (raw.title || '').trim();\n  let source = 'Industry News';\n  if (title.includes(' - ')) {\n    const parts = title.split(' - ');\n    const src = parts.pop().trim();\n    title = parts.join(' - ').trim();\n    if (src) source = src;\n  } else if (title.includes(' | ')) {\n    const parts = title.split(' | ');\n    const src = parts.pop().trim();\n    title = parts.join(' | ').trim();\n    if (src) source = src;\n  }\n  if (raw.source) {\n    if (typeof raw.source === 'string') {\n      source = raw.source;\n    } else if (typeof raw.source === 'object') {\n      source = raw.source._ || raw.source.name || raw.source['#text'] || source;\n    }\n  }\n\n  // A. Check against previous content in Cloudflare D1\n  let isDuplicateOfExisting = false;\n  for (const existingTitle of existingTitles) {\n    if (isSimilar(title, existingTitle)) {\n      isDuplicateOfExisting = true;\n      break;\n    }\n  }\n  if (isDuplicateOfExisting) continue;\n\n  // B. Check against content already accepted in THIS execution batch\n  let isDuplicateInBatch = false;\n  for (const batchTitle of acceptedTitles) {\n    if (isSimilar(title, batchTitle)) {\n      isDuplicateInBatch = true;\n      break;\n    }\n  }\n  if (isDuplicateInBatch) continue;\n\n  // Clean description\n  let description = (raw.contentSnippet || raw.content || raw.description || '').trim();\n  description = description.replace(/<[^>]*>?/gm, '').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\n\n  // Sector Categorization: Shipping & Logistics\n  const combined = `${title} ${description}`.toLowerCase();\n  let category = 'Logistics';\n  let contentType = 'news';\n\n  if (/(shipping|ocean freight|ocean carrier|vessel|maritime|port|container ship|dry bulk|tanker|red sea|suez|terminal operator|dock|berth|boxship|shipping line)/.test(combined)) {\n    category = 'Shipping';\n  } else {\n    category = 'Logistics';\n  }\n\n  // Trend detection\n  if (/(surge|plunge|soar|record high|forecast|outlook|inflation|growth rate|freight index|spot rate|downturn|quarterly report|earnings|q1|q2|q3|q4)/.test(combined)) {\n    contentType = 'trend';\n  }\n\n  const categoryImages = {\n    'Shipping': 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80',\n    'Logistics': 'https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=1200&q=80'\n  };\n\n  const imageUrl = raw.enclosure?.url || categoryImages[category] || categoryImages['Logistics'];\n\n  seenUrls.add(sourceUrl);\n  acceptedTitles.push(title);\n\n  acceptedArticles.push({\n    json: {\n      title,\n      description,\n      source,\n      source_url: sourceUrl,\n      image_url: imageUrl,\n      category,\n      published_at: new Date(pubTime).toISOString(),\n      content_type: contentType\n    }\n  });\n}\n\nreturn acceptedArticles;\n"
      },
