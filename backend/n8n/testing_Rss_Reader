      "parameters": {
        "jsCode": "// LogiPulse Smart Content Deduplicator\n// 1. Rejects articles older than 7 days\n// 2. Rejects exact URL duplicates\n// 3. Rejects similar/rephrased scrap content (comparing against D1 & current batch)\n\nconst MAX_DAYS = 7;\nconst cutoffTime = Date.now() - (MAX_DAYS * 24 * 60 * 60 * 1000);\n\n// Stop words for title tokenization\nconst stopWords = new Set([\n  'a', 'about', 'above', 'after', 'again', 'against', 'all', 'am', 'an', 'and',\n  'any', 'are', 'as', 'at', 'be', 'because', 'been', 'before', 'being', 'below',\n  'between', 'both', 'but', 'by', 'can', 'could', 'did', 'do', 'does', 'doing',\n  'down', 'during', 'each', 'few', 'for', 'from', 'further', 'had', 'has', 'have',\n  'having', 'he', 'her', 'here', 'how', 'i', 'if', 'in', 'into', 'is', 'it',\n  'its', 'just', 'more', 'most', 'must', 'my', 'no', 'nor', 'not', 'now', 'of',\n  'off', 'on', 'once', 'only', 'or', 'other', 'our', 'out', 'over', 'own', 'same',\n  'she', 'should', 'so', 'some', 'such', 'than', 'that', 'the', 'their', 'theirs',\n  'them', 'then', 'there', 'these', 'they', 'this', 'those', 'through', 'to',\n  'too', 'under', 'until', 'up', 'very', 'was', 'we', 'were', 'what', 'when',\n  'where', 'which', 'while', 'who', 'whom', 'why', 'will', 'with', 'you', 'your',\n  'says', 'said', 'new', 'top', 'first', 'week', 'report', 'reports'\n]);\n\nfunction extractWords(text) {\n  return new Set(\n    (text || '')\n      .toLowerCase()\n      .replace(/[^\\w\\s]/g, ' ')\n      .split(/\\s+/)\n      .filter(w => w.length >= 3 && !stopWords.has(w))\n  );\n}\n\nfunction isSimilar(titleA, titleB) {\n  const a = extractWords(titleA);\n  const b = extractWords(titleB);\n  if (a.size === 0 || b.size === 0) return false;\n\n  let common = 0;\n  for (const w of a) {\n    if (b.has(w)) common++;\n  }\n\n  // If 4 or more key words match (e.g. \"mahindra\", \"logistics\", \"appoints\", \"turra\", \"ceo\")\n  if (common >= 4) return true;\n\n  // For short titles (<= 5 words), 3 matching words indicates duplicate news\n  const minSize = Math.min(a.size, b.size);\n  if (minSize <= 5 && common >= 3) return true;\n\n  // Overlap ratio check\n  const overlap = common / minSize;\n  return overlap >= 0.58;\n}\n\n// 1. Load existing headlines already in D1 database\nconst existingTitles = [];\ntry {\n  const d1Res = $('Get Existing D1 Headlines').first()?.json;\n  if (d1Res && Array.isArray(d1Res.data)) {\n    for (const item of d1Res.data) {\n      if (item.title) existingTitles.push(item.title);\n    }\n  }\n} catch (e) {}\n\nconst incomingItems = $input.all();\nconst acceptedArticles = [];\nconst acceptedTitles = [];\nconst seenUrls = new Set();\n\nfor (const item of incomingItems) {\n  const raw = item.json;\n\n  // Date filter: strictly within last 7 days\n  const rawDate = raw.pubDate || raw.isoDate || raw.published;\n  const pubTime = rawDate ? new Date(rawDate).getTime() : Date.now();\n  if (isNaN(pubTime) || pubTime < cutoffTime) continue;\n\n  // URL check\n  const sourceUrl = (raw.link || raw.guid || '').trim();\n  if (!sourceUrl || seenUrls.has(sourceUrl)) continue;\n\n  // Clean Title\n  let title = (raw.title || '').trim();\n  let source = 'Logistics News';\n  if (title.includes(' - ')) {\n    const parts = title.split(' - ');\n    const src = parts.pop().trim();\n    title = parts.join(' - ').trim();\n    if (src) source = src;\n  }\n  if (raw.source) {\n    if (typeof raw.source === 'string') {\n      source = raw.source;\n    } else if (typeof raw.source === 'object') {\n      source = raw.source._ || raw.source.name || raw.source['#text'] || source;\n    }\n  }\n\n  // A. Check against articles ALREADY in Cloudflare D1 (previous runs)\n  let isDuplicateOfExisting = false;\n  for (const existingTitle of existingTitles) {\n    if (isSimilar(title, existingTitle)) {\n      isDuplicateOfExisting = true;\n      break;\n    }\n  }\n  if (isDuplicateOfExisting) continue; // Skip scrap content already in D1\n\n  // B. Check against articles already accepted in THIS batch\n  let isDuplicateInBatch = false;\n  for (const batchTitle of acceptedTitles) {\n    if (isSimilar(title, batchTitle)) {\n      isDuplicateInBatch = true;\n      break;\n    }\n  }\n  if (isDuplicateInBatch) continue; // Skip duplicate reports in same run\n\n  // Clean description\n  let description = (raw.contentSnippet || raw.content || raw.description || '').trim();\n  description = description.replace(/<[^>]*>?/gm, '').replace(/&nbsp;/g, ' ').trim();\n\n  // Categorization\n  const combined = `${title} ${description}`.toLowerCase();\n  let category = 'Logistics';\n  let contentType = 'news';\n\n  if (/(ai|robot|autonomous|drone|computer vision|algorithm|machine learning|llm|automation|amr|agv|humanoid|sensor)/.test(combined)) {\n    category = 'AI & Robotics';\n    contentType = 'ai_insight';\n  } else if (/(warehouse|fulfillment|dark store|inventory|storage|pallet|forklift|cold storage|distribution center|racking|wms)/.test(combined)) {\n    category = 'Warehousing';\n  } else if (/(ship|ocean|maritime|port|container|vessel|dock|carrier|red sea|suez|terminal operator|drayage)/.test(combined)) {\n    category = 'Shipping';\n  } else if (/(india|delhi|mumbai|gujarat|bengaluru|nagpur|dfc|nhai|railway|concor|bharatmala|ulip|sagarmala|dedicated freight)/.test(combined)) {\n    category = 'India';\n  } else if (/(truck|fleet|highway|electric truck|ev freight|intermodal|linehaul|rail freight|driver shortage|freight carrier)/.test(combined)) {\n    category = 'Transportation';\n  } else if (/(supply chain|nearshore|reshoring|sourcing|procurement|tariff|supplier|lead time|shortage|geopolitical)/.test(combined)) {\n    category = 'Supply Chain';\n  }\n\n  if (/(surge|plunge|soar|record high|forecast|outlook|inflation|benchmark|growth rate|index|quarterly report|q1|q2|q3|q4)/.test(combined)) {\n    if (contentType !== 'ai_insight') {\n      contentType = 'trend';\n    }\n  }\n\n  const categoryImages = {\n    'AI & Robotics': 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1200&q=80',\n    'Warehousing': 'https://images.unsplash.com/photo-1553413077-190dd305871c?auto=format&fit=crop&w=1200&q=80',\n    'Shipping': 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80',\n    'Transportation': 'https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=1200&q=80',\n    'India': 'https://images.unsplash.com/photo-1474487548417-781cb71495f3?auto=format&fit=crop&w=1200&q=80',\n    'Supply Chain': 'https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=1200&q=80',\n    'Logistics': 'https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=1200&q=80'\n  };\n\n  const imageUrl = raw.enclosure?.url || categoryImages[category] || categoryImages['Logistics'];\n\n  seenUrls.add(sourceUrl);\n  acceptedTitles.push(title);\n\n  acceptedArticles.push({\n    json: {\n      title,\n      description,\n      source,\n      source_url: sourceUrl,\n      image_url: imageUrl,\n      category,\n      published_at: new Date(pubTime).toISOString(),\n      content_type: contentType\n    }\n  });\n}\n\nreturn acceptedArticles;"
      },
